include(${CMAKE_CURRENT_LIST_DIR}/EngineSources.cmake)
set(M7ARC_7ZIP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../third_party/7zip")
list(TRANSFORM M7ARC_UPSTREAM_SOURCES PREPEND "${M7ARC_7ZIP_ROOT}/")
add_library(sevenzip_objects OBJECT ${M7ARC_UPSTREAM_SOURCES})
set_target_properties(sevenzip_objects PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_STANDARD 17 CXX_EXTENSIONS OFF)
target_compile_definitions(sevenzip_objects PRIVATE _REENTRANT _FILE_OFFSET_BITS=64 _LARGEFILE_SOURCE Z7_EXTERNAL_CODECS EXPORT_CODECS)
target_sources(sevenzip_objects PRIVATE "${M7ARC_7ZIP_ROOT}/CPP/Windows/DLL.cpp" "${M7ARC_7ZIP_ROOT}/CPP/7zip/Compress/CodecExports.cpp")
if(APPLE AND CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    enable_language(ASM)
    target_sources(sevenzip_objects PRIVATE "${M7ARC_7ZIP_ROOT}/Asm/arm64/LzmaDecOpt.S")
    set_source_files_properties("${M7ARC_7ZIP_ROOT}/C/LzmaDec.c" PROPERTIES COMPILE_DEFINITIONS Z7_LZMA_DEC_OPT)
elseif(APPLE AND NOT CMAKE_OSX_ARCHITECTURES AND CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
    enable_language(ASM)
    target_sources(sevenzip_objects PRIVATE "${M7ARC_7ZIP_ROOT}/Asm/arm64/LzmaDecOpt.S")
    set_source_files_properties("${M7ARC_7ZIP_ROOT}/C/LzmaDec.c" PROPERTIES COMPILE_DEFINITIONS Z7_LZMA_DEC_OPT)
endif()
find_package(Threads REQUIRED)
add_library(m7arc_engine SHARED ${CMAKE_CURRENT_LIST_DIR}/../src/engine/ArchiveEngine.cpp ${CMAKE_CURRENT_LIST_DIR}/../src/engine/MemoryEstimate.cpp ${CMAKE_CURRENT_LIST_DIR}/../src/engine/EngineRuntime.cpp $<TARGET_OBJECTS:sevenzip_objects>)
target_compile_features(m7arc_engine PUBLIC cxx_std_20)
target_compile_definitions(m7arc_engine PRIVATE Z7_EXTERNAL_CODECS EXPORT_CODECS)
target_include_directories(m7arc_engine PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../src" PRIVATE "${M7ARC_7ZIP_ROOT}/CPP" "${M7ARC_7ZIP_ROOT}/C")
target_link_libraries(m7arc_engine PRIVATE m7arc_platform Threads::Threads ${CMAKE_DL_LIBS})
set_target_properties(m7arc_engine PROPERTIES MACOSX_RPATH ON INSTALL_NAME_DIR "@rpath" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
if(BUILD_TESTING)
    add_executable(m7arc_engine_tests ${CMAKE_CURRENT_LIST_DIR}/../tests/engine/EngineIntegration.cpp)
    target_link_libraries(m7arc_engine_tests PRIVATE m7arc_engine)
    add_test(NAME engine.integration COMMAND m7arc_engine_tests)
    add_library(m7arc_example_module MODULE
        ${CMAKE_CURRENT_LIST_DIR}/../tests/engine/modules/ExampleModule.cpp
        "${M7ARC_7ZIP_ROOT}/CPP/Common/MyWindows.cpp")
    target_compile_features(m7arc_example_module PRIVATE cxx_std_20)
    target_include_directories(m7arc_example_module PRIVATE "${M7ARC_7ZIP_ROOT}/CPP")
    set_target_properties(m7arc_example_module PROPERTIES
        PREFIX "" SUFFIX ".dylib" CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
    add_executable(m7arc_external_module_tests ${CMAKE_CURRENT_LIST_DIR}/../tests/engine/ExternalModulesTest.cpp)
    target_link_libraries(m7arc_external_module_tests PRIVATE m7arc_engine)
    add_test(NAME engine.external_modules COMMAND m7arc_external_module_tests "$<TARGET_FILE:m7arc_example_module>")
endif()
